{
  "name": "fm",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "just dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun tools/migrate.ts",
    "db:migrate:remote": "bun tools/migrate.ts --remote",
    "db:seed": "bun tools/seed.ts",
    "build": "vite build && wrangler types --config .output/server/wrangler.json worker-configuration.d.ts",
    "preview": "wrangler dev --config .output/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "wrangler deploy --config .output/server/wrangler.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "check": "oxlint . && oxfmt --check . && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/redact": "^0.2.4",
    "@unpic/react": "^1.0.2",
    "@videojs/react": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "effect": "^4.1.2",
    "lucide-react": "^1.67.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cf": "^1.0.0-beta.27",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "miniflare": "^4.20260730.0",
    "nitro": "^3.0.261103-rc",
    "oxfmt": "^0.76.0",
    "oxlint": "1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.2",
    "ultracite": "^8.1.1",
    "vite": "^8.0.0",
    "wrangler": "^4.157.0"
  }
}
